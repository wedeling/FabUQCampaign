#LAMMPS code written by LA van Goor 22-01-2026 

# Initialize 
units metal
dimension 3
boundary p p f
atom_style atomic

# Create Simulation Box
variable Len equal 175.0
variable Wid equal 34.04578081873656
variable Hei equal 34.04578081873656

region box block 0 ${Wid} 0 ${Wid} 0 ${Len} # Define simulation box size
create_box 2 box  # Create box with 2 atom types

variable h_fix     equal 6.0           # total (empty + graphene + empty)
variable dz_graph  equal 0.3           # graphene thickness
variable dz_empty  equal (v_h_fix-v_dz_graph)/2.0   # symmetric
variable W equal (v_Len-v_h_fix)/2.0     # left & right Cu thickness

# central empty/graphene/empty stack
variable e1     equal v_W+v_dz_empty+0.1
variable g      equal v_e1+v_dz_graph
variable e2     equal v_W+v_h_fix-0.1    # = W + 6.0


# Left thermostat regions
variable st     equal 3.0          # left_stuck high (3.0 thick)
variable th  equal v_st+4.0 
variable sth equal v_Len-3.0
variable thh equal v_sth-4.0

# Regions copper / graphene
region left_block  block 0 v_Wid 0 v_Wid 0.0 v_W 
region empty       block 0 v_Wid 0 v_Wid v_W v_e1   
region graphene    block 0 v_Wid 0 v_Wid v_e1 v_g   
region empty2      block 0 v_Wid 0 v_Wid v_g v_e2 
region right_block block 0 v_Wid 0 v_Wid v_e2 v_Len 

# Regions temp
region left_stuck  block 0 v_Wid 0 v_Wid 0.0 v_st
region left_edge   block 0 v_Wid 0 v_Wid v_st v_th 
region right_edge  block 0 v_Wid 0 v_Wid v_thh v_sth
region right_stuck block 0 v_Wid 0 v_Wid v_sth v_Len
region whole block EDGE EDGE EDGE EDGE EDGE EDGE units box



# Define Masses
mass 1 63.546  # Mass of Copper (atom type 1)
mass 2 12.011  # Mass of Carbon (atom type 2)

# Create Copper Atoms
lattice fcc 3.6  # Lattice constant for Cu
create_atoms 1 region left_block  # Create Cu atoms in left block
create_atoms 1 region right_block  # Create Cu atoms in right block


# Create Carbon Atoms in Honeycomb structure
lattice custom 2.46 &
    a1 1.0 0.0 0.0 &
    a2 -0.5 0.87 0.0 &
    a3 0.0 0.0 0.1 &  
    basis 0.0 0.0 0.0 &
    basis 0.33333 0.66667 0.0
create_atoms 2 region graphene

# Groups
group Cu_all type 1
group G_all type 2
group left_group region left_edge
group right_group region right_edge
group stuckleft region left_stuck
group stuckright region right_stuck 


# Potentials
pair_style hybrid eam/alloy airebo 3.0 lj/cut 10.0
pair_coeff * * eam/alloy Cu.eam.alloy Cu NULL # EAM potential file for Copper
pair_coeff * * airebo CH.airebo NULL C  # AIREBO potential file for Carbon
pair_coeff 1 2 lj/cut 0.02578 3.0825  # LJ parameters between Cu and C


#  Temperature Control 
fix left_cold left_group langevin 400.0 400.0 0.1 12345 tally yes
fix right_hot right_group langevin 200.0 200.0 0.1 67890 tally yes
fix 3 all nve

# Freeze left and right atoms
fix freeze stuckleft setforce 0.0 0.0 0.0
fix freeze2 stuckright setforce 0.0 0.0 0.0
velocity stuckleft set 0.0 0.0 0.0
velocity stuckright set 0.0 0.0 0.0

# Initialize 
minimize 1.0e-4 1.0e-6 1000 10000
thermo 10000
thermo_style custom step
# timestep
timestep 0.001
run 1000000


# Output VACF
compute  cuVACF Cu_all vacf
fix myAveragecu Cu_all ave/time 1 1 1 c_cuVACF[1] c_cuVACF[2] c_cuVACF[3] c_cuVACF[4] file vacf_cu.out
compute  gVACF G_all vacf
fix myAverageg G_all ave/time 1 1 1 c_gVACF[1] c_gVACF[2] c_gVACF[3] c_gVACF[4] file vacf_g.out

#Output Temp
compute bins_tot all chunk/atom bin/1d z 0.0 0.0125 units reduced region whole
compute temp_bins_tot all temp/chunk bins_tot
fix output_temp_tot all ave/chunk 1000 1 1000 bins_tot temp file tmp_tot.out

log log.lammps
thermo 10000
thermo_style custom step temp pe ke etotal press f_left_cold f_right_hot

# Run
run 100

#unfix output_temp_tot
#unfix myAveragecu
#unfix myAverageg

#dump           d1 all custom 100 eq_afterNEMD.lammpstrj id type x y z
#dump_modify    d1 sort id

#run 1000

